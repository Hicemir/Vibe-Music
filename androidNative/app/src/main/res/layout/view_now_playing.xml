<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/now_playing_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:clickable="true"
    android:focusable="true">

    <!-- Layer 1: Dynamic Album-Tinted Background -->
    <View
        android:id="@+id/np_bg_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_primary" />

    <!-- Layer 2: Single Morphing Cover Art (Mini -> Full -> Stage 1 Bleed -> Stage 2 Compact) -->
    <ImageView
        android:id="@+id/np_cover"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_cover_rounded_6dp"
        android:clipToOutline="true"
        android:src="@drawable/ic_music_note"
        android:contentDescription="Cover Art" />

    <!-- Layer 3: Stage 1 Artwork Scrim (Fades cover bottom cleanly into dark bg behind title & seekbar) -->
    <View
        android:id="@+id/np_stage1_art_scrim"
        android:layout_width="match_parent"
        android:layout_height="440dp"
        android:alpha="0" />

    <!-- Layer 4: Mini-Player Fade Strip (Visible only during early pull-up from mini player) -->
    <LinearLayout
        android:id="@+id/np_mini_fade_row"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:visibility="gone">

        <!-- Spacer matching mini_cover 44dp slot -->
        <View
            android:layout_width="44dp"
            android:layout_height="44dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/np_mini_fade_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Play something"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/np_mini_fade_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap a track or radio to begin"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageView
            android:id="@+id/np_mini_fade_play_pause"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@drawable/ic_play"
            android:tint="@color/text_primary"
            android:contentDescription="Play/Pause" />

        <ImageView
            android:id="@+id/np_mini_fade_next"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:padding="6dp"
            android:src="@drawable/ic_skip_next"
            android:tint="@color/text_primary"
            android:visibility="gone"
            android:contentDescription="Next" />
    </LinearLayout>

    <!-- Layer 5: Main Player Controls Layout -->
    <LinearLayout
        android:id="@+id/np_main_player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Bar -->
        <RelativeLayout
            android:id="@+id/np_top_bar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/np_collapse"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:padding="6dp"
                android:src="@drawable/ic_chevron_down"
                android:tint="@color/text_primary"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Collapse" />

            <TextView
                android:id="@+id/np_header_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Now Playing"
                android:textColor="#CCFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/np_equalizer"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_tune"
                    android:tint="@color/text_primary"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Equalizer" />

                <ImageView
                    android:id="@+id/np_more_options"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_more_vert"
                    android:tint="@color/text_primary"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Track Options" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Player Body -->
        <LinearLayout
            android:id="@+id/np_body"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Cover Slot Spacer (Defines resting Stage 0 square artwork position) -->
            <View
                android:id="@+id/np_cover_slot"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp" />

            <!-- 2. Track Title & Artist (Left-aligned, translates smoothly in Stage 1) -->
            <LinearLayout
                android:id="@+id/np_meta_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/np_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Play something"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <TextView
                    android:id="@+id/np_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Tap a track or radio to begin"
                    android:textColor="#B8C0CC"
                    android:textSize="15sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- 3. YouTube Music Style Action Pills Row -->
            <HorizontalScrollView
                android:id="@+id/np_pills_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="14dp"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Like Pill -->
                    <LinearLayout
                        android:id="@+id/btn_np_like"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:background="@drawable/bg_action_pill"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginEnd="8dp">

                        <ImageView
                            android:id="@+id/np_like"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_heart"
                            android:tint="@color/text_primary" />

                        <TextView
                            android:id="@+id/np_like_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Like"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Save / Add to Playlist Pill -->
                    <LinearLayout
                        android:id="@+id/btn_np_save"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:background="@drawable/bg_action_pill"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginEnd="8dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_playlist_add"
                            android:tint="@color/text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Save"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Lyrics Pill -->
                    <LinearLayout
                        android:id="@+id/btn_np_lyrics"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:background="@drawable/bg_action_pill"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginEnd="8dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_lyrics"
                            android:tint="@color/text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Lyrics"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Audio Volume Pill -->
                    <LinearLayout
                        android:id="@+id/btn_np_audio"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:background="@drawable/bg_action_pill"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginEnd="8dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_volume_up"
                            android:tint="@color/text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Volume"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Share Pill -->
                    <LinearLayout
                        android:id="@+id/btn_np_share"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:background="@drawable/bg_action_pill"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginEnd="8dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_share"
                            android:tint="@color/text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Share"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Sleep Timer Pill -->
                    <LinearLayout
                        android:id="@+id/btn_np_timer"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:background="@drawable/bg_action_pill"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/np_timer_icon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_timer"
                            android:tint="@color/text_primary" />

                        <TextView
                            android:id="@+id/np_timer_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Timer"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- 4. Expandable Audio Volume Slider Bar -->
            <LinearLayout
                android:id="@+id/np_volume_bar_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp"
                android:background="@drawable/bg_thin_button"
                android:layout_marginBottom="10dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/np_volume_down"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_volume_down"
                    android:tint="@color/text_secondary"
                    android:contentDescription="Volume Down" />

                <SeekBar
                    android:id="@+id/np_volume_slider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:progressTint="@color/accent_green"
                    android:thumbTint="@color/accent_green" />

                <ImageView
                    android:id="@+id/np_volume_up"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_volume_up"
                    android:tint="@color/text_secondary"
                    android:contentDescription="Volume Up" />
            </LinearLayout>

            <!-- 5 & 6. Seekbar + Transport Group (Translates cleanly above Queue Sheet in Stage 1) -->
            <LinearLayout
                android:id="@+id/np_transport_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false">

                <SeekBar
                    android:id="@+id/np_seekbar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="6dp"
                    android:clipToPadding="false"
                    android:splitTrack="false"
                    android:progressTint="#FFFFFFFF"
                    android:progressBackgroundTint="#40FFFFFF"
                    android:thumbTint="#FFFFFFFF" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/np_time_current"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:text="0:00"
                        android:textColor="#99FFFFFF"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/np_time_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="0:00"
                        android:textColor="#99FFFFFF"
                        android:textSize="12sp" />
                </RelativeLayout>

                <!-- Transport Controls -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <ImageView
                        android:id="@+id/np_shuffle"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="20dp"
                        android:padding="8dp"
                        android:src="@drawable/ic_shuffle"
                        android:tint="@color/text_secondary"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Shuffle" />

                    <ImageView
                        android:id="@+id/np_prev"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="16dp"
                        android:padding="10dp"
                        android:src="@drawable/ic_skip_previous"
                        android:tint="@color/text_primary"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Previous" />

                    <FrameLayout
                        android:id="@+id/np_play_pause_bg"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_circle_white"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/np_play_pause"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_play"
                            android:tint="@color/black"
                            android:contentDescription="Play/Pause" />
                    </FrameLayout>

                    <ImageView
                        android:id="@+id/np_next"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="16dp"
                        android:padding="10dp"
                        android:src="@drawable/ic_skip_next"
                        android:tint="@color/text_primary"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Next" />

                    <ImageView
                        android:id="@+id/np_repeat"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="20dp"
                        android:padding="8dp"
                        android:src="@drawable/ic_repeat"
                        android:tint="@color/text_secondary"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Repeat" />
                </LinearLayout>
            </LinearLayout>

            <!-- 7. YouTube Music Style Slide-Up Queue Peek Bar -->
            <LinearLayout
                android:id="@+id/np_bottom_queue_peek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="60dp"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="16dp"
                android:background="@null"
                android:clickable="true"
                android:focusable="true">

                <View
                    android:layout_width="40dp"
                    android:layout_height="4dp"
                    android:background="@drawable/bg_pill_handle" />

                <TextView
                    android:id="@+id/np_bottom_queue_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Up next"
                    android:textColor="#CCFFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Layer 6: Stage 2 Compact Header (Settles at top when Queue is fully expanded, Image 12) -->
    <LinearLayout
        android:id="@+id/np_queue_compact_header"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:clickable="true"
        android:focusable="true"
        android:alpha="0"
        android:visibility="gone">

        <!-- Spacer matching Stage 2 44dp cover at (16dp, 12dp) -->
        <View
            android:layout_width="44dp"
            android:layout_height="44dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/np_compact_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Play something"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/np_compact_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Tap a track or radio to begin"
                android:textColor="#B8C0CC"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageView
            android:id="@+id/np_compact_play_pause"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_play"
            android:tint="@color/text_primary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Play/Pause" />

        <ImageView
            android:id="@+id/np_compact_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:padding="8dp"
            android:src="@drawable/ic_skip_next"
            android:tint="@color/text_primary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Next" />
    </LinearLayout>

    <!-- Layer 7: Two-Staged Slide-Up Queue Sheet -->
    <LinearLayout
        android:id="@+id/np_queue_slider"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_sheet_top_rounded"
        android:orientation="vertical"
        android:elevation="14dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <!-- Drag Hitbox Header -->
        <LinearLayout
            android:id="@+id/np_queue_drag_hitbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="4dp"
            android:clickable="true"
            android:focusable="true">

            <View
                android:id="@+id/np_queue_drag_pill"
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_pill_handle" />

            <RelativeLayout
                android:id="@+id/np_queue_header_row"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/np_queue_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="Up next"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btn_queue_clear"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:background="@drawable/bg_action_pill"
                        android:text="Clear queue"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />

                    <ImageView
                        android:id="@+id/np_queue_close"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="6dp"
                        android:padding="5dp"
                        android:src="@drawable/ic_chevron_down"
                        android:tint="@color/text_secondary"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Close Queue" />
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>

        <!-- Dedicated "Now playing" Section -->
        <LinearLayout
            android:id="@+id/np_queue_now_playing_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="#12FFFFFF">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Now playing"
                android:textColor="#99FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:id="@+id/np_queue_current_row"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/np_queue_current_cover"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_cover_rounded_6dp"
                    android:clipToOutline="true"
                    android:src="@drawable/ic_music_note"
                    android:contentDescription="Current Cover" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/np_queue_current_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Song Title"
                        android:textColor="@color/accent_green"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/np_queue_current_artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Artist"
                        android:textColor="#B8C0CC"
                        android:textSize="12sp"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <com.vibemusic.nativeapp.ui.EqualizerBarsView
                    android:id="@+id/np_queue_equalizer"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_marginEnd="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- "Next up · X" Section Header Row -->
        <RelativeLayout
            android:id="@+id/np_queue_next_up_header"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/np_queue_next_up_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="Next up"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/np_queue_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp" />
    </LinearLayout>

    <!-- Layer 8: Slide-Up Synced Lyrics Sheet with Tap-Outside Scrim -->
    <FrameLayout
        android:id="@+id/np_lyrics_slider_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="20dp"
        android:visibility="gone">

        <View
            android:id="@+id/np_lyrics_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#77000000"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:id="@+id/np_lyrics_slider"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="48dp"
            android:background="@drawable/bg_sheet_top_rounded"
            android:orientation="vertical"
            android:elevation="14dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:id="@+id/np_lyrics_drag_hitbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="14dp"
                android:paddingBottom="12dp"
                android:clickable="true"
                android:focusable="true">

                <View
                    android:id="@+id/np_lyrics_drag_pill"
                    android:layout_width="54dp"
                    android:layout_height="5dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_pill_handle" />

                <RelativeLayout
                    android:id="@+id/np_lyrics_header_row"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/np_lyrics_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:text="Lyrics"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/np_lyrics_close"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:padding="6dp"
                        android:src="@drawable/ic_chevron_down"
                        android:tint="@color/text_secondary"
                        android:background="?attr/selectableItemBackground"
                        android:contentDescription="Close Lyrics" />
                </RelativeLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/np_lyrics_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingTop="20dp"
                    android:paddingBottom="60dp" />

                <TextView
                    android:id="@+id/np_lyrics_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/no_lyrics"
                    android:textColor="@color/text_muted"
                    android:textSize="16sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
