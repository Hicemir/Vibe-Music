<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/playlist_card_root"
    android:layout_width="140dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginEnd="12dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Cover Mosaic (2x2 grid of covers or single cover) -->
    <FrameLayout
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:background="@drawable/bg_card"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/pl_cover_single"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_library"
            android:background="@color/bg_surface_highlight"
            android:contentDescription="Cover" />

        <!-- 2x2 Mosaic container -->
        <GridLayout
            android:id="@+id/pl_mosaic"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:columnCount="2"
            android:rowCount="2"
            android:visibility="gone">

            <ImageView
                android:id="@+id/pl_mosaic_1"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/pl_mosaic_2"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/pl_mosaic_3"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/pl_mosaic_4"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:scaleType="centerCrop" />
        </GridLayout>

        <FrameLayout
            android:id="@+id/pl_btn_play"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:background="@drawable/bg_circle_white"
            android:backgroundTint="@color/accent_green"
            android:elevation="4dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Play playlist">

            <ImageView
                android:id="@+id/pl_btn_play_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_play"
                android:tint="@color/black" />
        </FrameLayout>

    </FrameLayout>

    <TextView
        android:id="@+id/pl_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Playlist Name"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/pl_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="0 songs"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

</LinearLayout>
