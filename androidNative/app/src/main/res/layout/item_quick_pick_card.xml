<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qp_item_root"
    android:layout_width="match_parent"
    android:layout_height="115dp"
    android:layout_margin="3dp"
    android:background="@drawable/bg_card"
    android:clipToOutline="true"
    android:clickable="true"
    android:focusable="true">

    <!-- Cover Image filling entire card -->
    <ImageView
        android:id="@+id/qp_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_music_note"
        android:background="@color/bg_surface_highlight" />

    <!-- Semi-transparent gradient scrim across the bottom to ensure text legibility -->
    <View
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_scrim" />

    <!-- Play/Preview Circle Badge in Top-Right -->
    <FrameLayout
        android:id="@+id/qp_cover_container"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:background="@drawable/bg_pill_active"
        android:elevation="4dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Preview Song">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_play"
            android:tint="@color/black" />
    </FrameLayout>

    <!-- Title and Artist overlaid on the bottom of the cover art -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/qp_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Song Title"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:shadowColor="#CC000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/qp_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="Artist"
            android:textColor="#D9FFFFFF"
            android:textSize="10sp"
            android:shadowColor="#CC000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

</FrameLayout>
